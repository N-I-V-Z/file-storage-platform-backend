# Match the database name, user, password, and ports in ../file-storage-platform-infra/.env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://file_storage:replace-with-local-password@127.0.0.1:5432/file_storage
REDIS_URL=redis://127.0.0.1:6379
STORAGE_ROOT=./.local-storage
# Per-file limit 512 MiB; per-project quota 10 GiB; keep 1 GiB free.
MAX_UPLOAD_BYTES=536870912
PROJECT_QUOTA_BYTES=10737418240
MIN_DISK_FREE_BYTES=1073741824
MAX_CONCURRENT_UPLOADS=4
UPLOAD_TIMEOUT_MS=600000
MAX_CONCURRENT_DOWNLOADS=16
DOWNLOAD_TIMEOUT_MS=600000
# ClamAV clamd must be reachable from the backend; scanner failure rejects uploads.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
SCAN_TIMEOUT_MS=300000
CORS_ORIGINS=http://localhost:3000

# Generate two different, long random values before enabling authentication.
JWT_ACCESS_SECRET=replace-with-random-access-secret
JWT_REFRESH_SECRET=replace-with-random-refresh-secret

# Optional: set both keys when connecting NestJS Observe.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
